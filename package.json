{
  "name": "docked",
  "version": "3.30.22-dev",
  "description": "Docker app maintenance tool",
  "keywords": [
    "docker",
    "updates"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "better-npm-audit": "^3.11.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "semver": "^7.7.4"
  },
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run client\"",
    "backend": "cd backend && go run ./cmd/api",
    "client": "cd client && npm run dev",
    "install-all": "npm install && cd client && npm install",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,md}\""
  }
}
