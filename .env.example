# Go backend listen address (ADDR overrides PORT when both are set)
PORT=3001

# Secrets / storage
JWT_SECRET=change-me-to-a-strong-random-string
DATA_DIR=./data

# OAuth / SSO Configuration (optional)
# Uncomment and configure to enable Single Sign-On
# OAUTH_PROVIDER=authentik
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_CLIENT_SECRET=your-client-secret
# OAUTH_ISSUER_URL=https://auth.example.com/application/o/docked
# OAUTH_SCOPES=openid,profile,email
# OAUTH_AUTO_REGISTER=true
# OAUTH_DEFAULT_ROLE=Administrator
# OAUTH_ALLOW_LOCAL_LOGIN=true
